---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Etheca - Building a Better Way to Work</title>
  <meta name="description" content="With Etheca, we're building a better way to work">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <main class="min-h-screen bg-[#1c1c1c] flex flex-col items-center justify-center px-4 md:px-8 lg:px-16 py-12 md:py-16 gap-9 md:gap-12 lg:gap-16">
    <div class="flex flex-col items-center gap-12 md:gap-16 max-w-4xl w-full animate-fade-in">
      <!-- Logo -->
      <div class="relative w-[100px] h-[140px] md:w-[120px] md:h-[168px] lg:w-[145px] lg:h-[201px]">
        <img
          src="/logo.svg"
          alt="Etheca Logo"
          class="w-full h-full object-contain"
        />
      </div>

      <!-- Tagline + Navigation -->
      <div class="flex flex-col items-center gap-9 md:gap-16 w-full">
        <!-- Tagline -->
        <p class="font-[family-name:var(--font-swear-text)] italic text-lg md:text-xl lg:text-2xl text-center text-white leading-normal max-w-2xl px-4">
          With Etheca, we're building a better way to work
        </p>

        <!-- Navigation -->
        <nav class="flex flex-col sm:flex-row gap-6 md:gap-12 lg:gap-[53px] items-center font-[family-name:var(--font-paper-mono)] text-xs text-[#ededed] uppercase tracking-wide">
          <a href="/values" class="transition-all duration-200 hover:text-white hover:scale-105 active:scale-95 py-2 px-3">
            VALUES
          </a>
          <a href="/blog" class="transition-all duration-200 hover:text-white hover:scale-105 active:scale-95 py-2 px-3">
            BLOGS
          </a>
          <a href="mailto:hello@etheca.watch" class="transition-all duration-200 hover:text-white hover:scale-105 active:scale-95 py-2 px-3">
            CONTACT
          </a>
        </nav>
      </div>
    </div>
  </main>

  <style>
    @keyframes fade-in {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in {
      animation: fade-in 0.3s ease-out;
    }
  </style>
</body>
</html>