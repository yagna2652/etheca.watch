---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout title={`${post.data.title} - Etheca`} description={post.data.description}>
  <div class="min-h-screen">
    <!-- DESKTOP LAYOUT -->
    <div class="hidden lg:block relative w-full min-h-screen">
      <!-- Back button - fixed position -->
      <div class="fixed" style="left: 281px; top: 169px;">
        <a
          href="/blog"
          class="inline-flex items-center gap-1 text-base font-medium italic text-white hover:text-gray-300 transition-colors"
          style="font-family: var(--font-swear-text);"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M20 20v-7a4 4 0 0 0-4-4H4"></path>
            <path d="M9 14 4 9l5-5"></path>
          </svg>
          <span>Back to Blogs</span>
        </a>
      </div>

      <!-- Fade gradient overlay -->
      <div
        class="fixed pointer-events-none"
        style="left: 451px; top: 0px; width: 507px; height: 200px; background: linear-gradient(to bottom, #1c1c1c 0%, transparent 100%); z-index: 10;"
      >
      </div>

      <!-- Blog post content - scrollable -->
      <article class="absolute pb-32" style="left: 451px; top: 169px; width: 507px;">
        <!-- Header -->
        <header class="mb-10">
          <h1 class="text-2xl font-bold text-white mb-4" style="font-family: var(--font-paper-mono);">
            {post.data.title}
          </h1>
          <div class="flex items-center gap-4 text-sm text-[#777777] mb-10" style="font-family: var(--font-paper-mono);">
            <time>{formatDate(post.data.date)}</time>
            {post.data.authors && post.data.authors.length > 0 && (
              <span>by {post.data.authors[0]}</span>
            )}
          </div>
          <div class="w-full h-px bg-[#ededed]"></div>
        </header>

        <!-- Content -->
        <div
          class="prose prose-invert max-w-none text-[#ededed]"
          style="font-family: var(--font-paper-mono);"
        >
          <Content />
        </div>
      </article>
    </div>

    <!-- MOBILE/TABLET LAYOUT -->
    <div class="lg:hidden">
      <div class="flex flex-col md:flex-row gap-8 md:gap-16 px-4 md:px-8 py-12 md:py-16 pb-32 max-w-7xl mx-auto">
        <!-- Back button -->
        <div class="shrink-0">
          <a
            href="/blog"
            class="inline-flex items-center gap-1 text-base font-medium italic text-white hover:text-gray-300 transition-colors"
            style="font-family: var(--font-swear-text);"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M20 20v-7a4 4 0 0 0-4-4H4"></path>
              <path d="M9 14 4 9l5-5"></path>
            </svg>
            <span>Back to Blogs</span>
          </a>
        </div>

        <!-- Blog post content -->
        <article class="flex-1 max-w-2xl">
          <!-- Header -->
          <header class="mb-10">
            <h1 class="text-2xl font-bold text-white mb-4" style="font-family: var(--font-paper-mono);">
              {post.data.title}
            </h1>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-sm text-[#777777] mb-10" style="font-family: var(--font-paper-mono);">
              <time>{formatDate(post.data.date)}</time>
              {post.data.authors && post.data.authors.length > 0 && (
                <span>by {post.data.authors[0]}</span>
              )}
            </div>
            <div class="w-full h-px bg-[#ededed]"></div>
          </header>

          <!-- Content -->
          <div
            class="prose prose-invert max-w-none text-[#ededed]"
            style="font-family: var(--font-paper-mono);"
          >
            <Content />
          </div>
        </article>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Custom prose styling for blog content */
  .prose h1, .prose h2, .prose h3 {
    color: #ededed;
    font-weight: 600;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose h1 {
    font-size: 1.5em;
  }

  .prose h2 {
    font-size: 1.3em;
  }

  .prose h3 {
    font-size: 1.1em;
  }

  .prose p {
    color: #ededed;
    line-height: 1.7;
    margin-bottom: 1em;
  }

  .prose ul, .prose ol {
    color: #ededed;
    margin: 1em 0;
    padding-left: 1.5em;
  }

  .prose li {
    margin: 0.5em 0;
  }

  .prose strong {
    color: #ffffff;
    font-weight: 600;
  }

  .prose a {
    color: #ffffff;
    text-decoration: underline;
  }

  .prose a:hover {
    opacity: 0.7;
  }
</style>
